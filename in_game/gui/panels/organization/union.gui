organization_geodiplomatic_theme = {
	blockoverride "organization_overview_tab_visible" {}
	blockoverride "organization_panel_overview_visible" {
		visible = "[InternationalOrganizationsView.Vars.NotExistOrHasValue( 'organizations', 'overview' )]"
	}
	blockoverride "organization_members_tab_down" {
		down = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}
	blockoverride "organization_panel_members_visible" {
		visible = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}

	blockoverride "organization_overview_list_bg" {
		margin = {10 0}
		spacing = 10
	}
	blockoverride "organization_overview_filtered_list" {
		margin_top = 5
		filtered_sorted_list = {
			datacontext = "[InternationalOrganizationsView.GetMembersSortSearch]"
			blockoverride "scroll_list_is_empty" {
				visible = "[IsDataModelEmpty(InternationalOrganizationsView.GetMemberItems)]"
			}
			blockoverride "scroll_list_is_empty_position" {
				position = { 0 300 }
			}
			blockoverride "scroll_list_is_empty_text" {
				text = "MEMBERS_SCROLL_LIST_EMPTY"
			}
			blockoverride "scroll_list_layout" {
				vbox = {
					block "organization_overview_list_bg" {
						using = layoutpolicy_expanding
						using = bg_secondary_inner_alt
						margin_bottom = 20
					}
					card_common = {
						margin = { 10 0 }
						blockoverride "header_size" {
							size = {-1 45}
						}
						blockoverride "common_header_back_decor" {
							background = {
								visible = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('iberian_union_active').IsSet]"
								texture = "gfx/interface/component_decoration/ios/union/iberian_union/union_header_2.dds"
								texture_density = 2
								spriteType = corneredstretched
								spriteborder = { 45 0 }
							}
						}
						blockoverride "common_header_icon_texture" {
							texture = "gfx/interface/icons/modifier_types/union_integration_level.dds"
						}
						blockoverride "common_header_text" {
							text = "union_integration_level_tooltip"
						}
						blockoverride "common_bottom_content" {
							text_multi = {
								layoutpolicy_horizontal = expanding
								maximumsize = {500 250}
								autoresize = yes
								raw_text = "union_mechanic_tooltip"
							}
						}
					}
					card_io_payments = {}
					flowcontainer = {
						direction = vertical
						spacing = 5
						margin_bottom = 14
						using = bg_paper_card_situations
						using = bg_cabinet_card_frame
						
						widget = {
							using = bg_scroll_card_header
							size = { 500 40 }
							expand = {}
							flowcontainer = {
								margin_top  = 2
								parentanchor = center
								icon = {
									size = { 25 25 }
									block "card_header_icon" {
										texture = "[InternationalOrganization.GetIcon]"
									}
									texture_density = 2
									glow = {
										name = "drop_shadow"
										glow_radius = 3
										color = {0.0 0.0 0.0 1.0}
										alpha = 0.5
									}
								}
								text_single = {
									text = "MAIN_ACTIONS"
								}
							}
						}
						
						flowcontainer = {
							direction = vertical
							margin_top = 5
							spacing = 5
							margin_left = 6
							ignoreinvisible = yes
							layoutpolicy_horizontal = expanding
							datamodel = "[InternationalOrganizationsView.GetActions]"
							item = {
								button_regular_diamond = {
									parentanchor = hcenter
									size = { 485 30 }
									visible = "[And(Not(EqualTo_string(GenericAction.GetKey, 'contribute_to_organization_treasury')), Not(EqualTo_string(GenericAction.GetKey, 'withdraw_from_organization_treasury')))]"
									text = "[GenericAction.GetNameWithNoTooltip]"
									scripted_action_tooltip = {
										click_type = left
										click_mode = single
										action_name = "[GenericAction.GetKey]"
										actor = "[InternationalOrganizationsView.GetPlayer]"
										parameter = {
											parameter_name = "recipient"
											parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
										}
									}
									enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
									tooltipwidget = {
										using = io_generic_action_button_tooltip
									}
								}
							}
						}

						flowcontainer = {
							direction = vertical
							spacing = 5
							margin_left = 15
							ignoreinvisible = yes
							layoutpolicy_horizontal = expanding
							datamodel = "[InternationalOrganizationsView.GetUnionInteractions]"
							item = {
								button_regular_diamond = {
									visible = "[PdxGuiWidget.IsUberButtonVisible]"
									parentanchor = hcenter
									size = { 485 30 }
									text = "[CountryInteraction.GetNameWithNoTooltip]"
									scripted_action_tooltip = {
										click_type = left
										click_mode = single
										action_name = "[CountryInteraction.GetKey]"
										action_direction = "offer"
										actor = "[InternationalOrganizationsView.GetPlayer]"
										parameter = {
											parameter_name = "international_organization"
											parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
										}
									}
									enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
									tooltipwidget = {
										ContextualTooltipType = {
											blockoverride "title_icon" {
												icon = {
													using = tooltip_title_icon_size
													texture = "[InternationalOrganizationsView.GetInternationalOrganization.GetIcon]"
												}
											}
											blockoverride "title_text" {
												text = "[CountryInteraction.GetNameWithNoTooltip]"
											}
											blockoverride "concept_link" {
												text = [country_interaction|E]
											}
											blockoverride "tooltip_content" {
												TooltipFlavorTextBlock = {
													visible = "[Not(StringIsEmpty(UIAction.GetDescription))]"
													blockoverride "text" {
														text = "[UIAction.GetDescription]"
													}
												}
												TooltipRequirementsList = {
													visible = "[And(Not(UIAction.IsEnabled), Not(StringIsEmpty(UIAction.GetConditions)))]"
													textcontext = "[UIAction.GetConditions]"
												}
												flowcontainer = {
													direction = vertical
													spacing = 3
													ignoreinvisible = yes
													visible = "[Not(UIAction.IsEnabled)]"
													datamodel = "[InternationalOrganizationsView.GetInternationalOrganization.GetMembers]"
													item = {
														button_regular_diamond = {
															visible = "[PdxGuiWidget.IsUberButtonVisible]"
															size = { 300 26 }
															text = "[Country.GetName]"
															scripted_action_tooltip = {
																click_type = left
																click_mode = single
																action_name = "[CountryInteraction.GetKey]"
																action_direction = "offer"
																actor = "[InternationalOrganizationsView.GetPlayer]"
																parameter = {
																	parameter_name = "international_organization"
																	parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
																}
																parameter = {
																	parameter_name = "recipient"
																	parameter_value = "[Country.MakeScope]"
																}
															}
															enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
															tooltipwidget = {
																ContextualTooltipType = {
																	blockoverride "title_text" { text = "[Country.GetName]" }
																	blockoverride "tooltip_content" {
																		TooltipRequirementsList = {
																			visible = "[Not(StringIsEmpty(UIAction.GetConditions))]"
																			textcontext = "[UIAction.GetConditions]"
																		}
																	}
																}
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
						# Ars Belli force_break_union button (1.4: was action_button_diamond + left_click_and_hold_action)
						button_regular_diamond = {
							parentanchor = hcenter
							size = { 485 30 }
							text = "force_break_union"
							visible = "[Player.IsMemberOfInternationalOrganization(InternationalOrganizationsView.GetInternationalOrganization)]"
							scripted_action_tooltip = {
								click_type = left
								click_mode = confirm
								action_name = "force_break_union"
								actor = "[InternationalOrganizationsView.GetPlayer]"
							}
							enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
							tooltipwidget = {
								using = io_force_break_union_button_tooltip
							}
						}
						visible = "[Player.IsMemberOfInternationalOrganization(InternationalOrganizationsView.GetInternationalOrganization)]"
					}

					vbox = {

						layoutpolicy_horizontal = expanding
						datamodel = "[InternationalOrganizationsView.GetMemberItems]"
						item = {
							estates_summary = {
								visible = "[And(Not(IsDataModelEmpty(MemberTypeItem.GetCountries)), MemberTypeItem.IsAllMembers)]"
								blockoverride "summary_datamodel" {
									datamodel = "[MemberTypeItem.GetCountries]"
								}
								blockoverride "summary_header_size" {
									size = {-1 40}
								}
								blockoverride "header_content" {
									
									tagtooltip_enabled = yes
									tooltipwidget = {
										ContextualTooltipType = {
											blockoverride "title_icon" {
												icon = {
													using = tooltip_title_icon_size
													texture = "[MemberTypeItem.GetIcon]"
												}
											}
											blockoverride "title_text" {
												text = "[MemberTypeItem.GetName]"
											}
											blockoverride "concept_link" {
												text = "[international_organization|e]"
											}
											blockoverride "tooltip_content" {
												TooltipTextBlock = {
													blockoverride "text" {
														text = "INTERNATIONAL_ORGANIZATION_TT_MEMBER"
													}
												}
											}
										}
									}
									
									expand = {}
									flowcontainer = {										spacing = 6

										icon = {
											size = { 25 25 }
											texture = "[MemberTypeItem.GetIcon]"
											texture_density = 2
											glow = {
												name = "drop_shadow"
												glow_radius = 3
												color = {0.0 0.0 0.0 1.0}
												alpha = 0.5
											}
										}
										text_single = {
											autoresize = yes
											raw_text = "[MemberTypeItem.GetMembersAmount] [MemberTypeItem.GetName]"
										}
									}
									expand = {}
									text_single = {
										layoutpolicy_horizontal = expanding
										layoutstretchfactor_horizontal = 100
										autoresize = no
										align = right|nobaseline
										elide = right
										visible = "[InternationalOrganizationsView.HasSpecialStatusCountry('senior_partner')]"
										text = "IO_SENIOR_MEMBER"
									}

									# seize seniority
									header_action_button_left_uber = {										visible = "[PdxGuiWidget.IsUberButtonVisible]"
										size = { 30 30 }
										blockoverride "button_icon_stretch_sprite" {}
										blockoverride "header_button_frame_inner" {visible = no}
										blockoverride "header_button_icon_size" { size = { 30 30 } }
										blockoverride "header_button_text_layout" {}
										blockoverride "icon_texture" {
											texture = "[GetSpecialStatusIconFromKey('senior_partner')]"
										}
										blockoverride "icon_overlay" {}
										scripted_action_tooltip = {
											click_type = left
											click_mode = confirm
											action_name = "take_over_seniority"
											action_direction = "request"
											actor = "[InternationalOrganizationsView.GetPlayer]"
											parameter = {
												parameter_name = "recipient"
												parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('union_senior_partner').GetCountry]"
											}
										}
										enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
										tooltipwidget = {
											ContextualTooltipType = {
												blockoverride "title_icon" {
													icon = {
														using = tooltip_title_icon_size
														texture = "[GetSpecialStatusIconFromKey('senior_partner')]"
													}
												}
												blockoverride "title_text" {
													text = "take_over_seniority"
												}
												blockoverride "concept_link" {
													text = [country_interaction|E]
												}
												blockoverride "tooltip_content" {
													TooltipFlavorTextBlock = {
														blockoverride "text" {
															visible = "[Not(StringIsEmpty(UIAction.GetDescription))]"
															text = "[UIAction.GetDescription]"
														}
													}
													TooltipStringPairList = {
														visible = "[Not(StringIsEmpty(UIAction.GetEffects))]"
														textcontext = "[UIAction.GetEffects]"
													}
													TooltipRequirementsList = {
														visible = "[And(Not(UIAction.IsEnabled), Not(StringIsEmpty(UIAction.GetConditions)))]"
														textcontext = "[UIAction.GetConditions]"
													}
												}
											}
										}
									}
								}
							}
						}
					}
					expand = {}
				}
			}
		}
	}

	blockoverride "call_organization_parliament_button" {
		scripted_action_tooltip = {
			click_type = left
			click_mode = single
			action_name = "union_call_organization_parliament"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			parameter = {
				parameter_name = "recipient"
				parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
			}
		}
	}

	blockoverride "organization_voting_members_card_visible"
	{
		visible = no
	}
	blockoverride "organization_parliament_scroll_area" {
		filtered_sorted_list = {
			datacontext = "[InternationalOrganizationsView.GetMembersSortSearch]"
			visible = "[InternationalOrganizationsView.GetInternationalOrganization.GetParliament.IsParliamentActive]"
			blockoverride "scroll_list_is_empty" {
				visible = "[IsDataModelEmpty(InternationalOrganizationsView.GetMemberItems)]"
			}
			blockoverride "scroll_list_is_empty_text" {
				text = "MEMBERS_SCROLL_LIST_EMPTY"
			}

			blockoverride "scroll_list_layout" {
				vbox = {
					vbox = {
						layoutpolicy_horizontal = expanding
						datamodel = "[InternationalOrganizationsView.GetMemberItems]"
						item = {
							vbox = {
								visible = "[And3(
									Not(IsDataModelEmpty(MemberTypeItem.GetCountries)), 
									MemberTypeItem.IsAllMembers,
									Not( EqualTo_string(MemberTypeItem.GetName, ShowSpecialStatusName('senior_partner')) )
								)]"
								layoutpolicy_horizontal = expanding
								spacing = 10
								using = members_entry
								blockoverride "card_header_button_header_content" {
									icon = {
										size = { 30 30 }
										block "card_header_button_icon_texture" {
											texture = "[GetSpecialStatusIconFromKey('junior_partner')]"
										}
										texture_density = 2
										glow = {
											name = "drop_shadow"
											glow_radius = 3
											color = {0.0 0.0 0.0 1.0}
											alpha = 0.3
										}
									}
									text_single = {
										using = layoutpolicy_expanding
										text = "UNION_MEMBERS_TO_ADJUST"
									}
								}
								maximumsize = { -1 600 }
								blockoverride "members_item_content" {
									hbox = {
										margin = {0 10}
										hbox = {
											layoutpolicy_horizontal = expanding
											dynamicgridbox = {
												layoutpolicy_horizontal = expanding
												flipdirection = yes
												datamodel_wrap = 1
												datamodel = "[MemberTypeItem.GetCountries]"
												item = {
													widget = {
														visible = "[And(Not(EqualTo_CFixedPoint(InternationalOrganizationsView.GetInternationalOrganization.GetModifierValue('union_integration_level'), Country.MakeScope.GetVariable('integrated_in_union').GetValue)),Not(Country.HasParticipatedInIOParliament(InternationalOrganizationsView.GetInternationalOrganization)))]"
														size = { 430 250 }
														paper_simple_card = {
															position = { 2 0 }
															size = { 430 215 }
															vbox = {
																maximumsize = {270 180}
																position = {5 5}
																spacing = 5
																margin_bottom = 5
																margin_top = 2
																widget = {
																	size = { 430 60 }
																	background = {
																		texture = "gfx/interface/component_tiles/square_tile.dds"
																		texture_density = 2
																		margin_bottom = 2
																		alpha = 0.5
																		modify_texture = {
																			using = color_black_texture
																			blend_mode = multiply
																		}
																	}
																	background = {
																		texture = "gfx/interface/colors/black.dds"
																		texture_density = 2
																		color = {0.68 0.35 0.85 1.0}
												
																		modify_texture = {
																			using = color_grey_texture
																		}
																		modify_texture = {
																			using = overlay_cloth_texture
																			blend_mode = overlay
																			alpha = 0.2
																		}
												
																		modify_texture = {
																			using = header_pattern_estates_crown
																			blend_mode = overlay
																		}
																		modify_texture = {
																			using = color_black_texture
																			blend_mode = multiply
																			alpha = 0.1
																		}
																	}
																	background = {
																		texture = "gfx/interface/component_tiles/square_tile.dds"
																		texture_density = 2
																		alpha = 0.3
																		modify_texture = {
																			using = color_black_texture
																			blend_mode = multiply
																		}
																		modify_texture = {
																			texture = "gfx/interface/component_masks/mask_fade_horizontal_sides.dds"
																			blend_mode = alphamultiply
																		}
																	}
																	using = bg_estates_frame
																	blockoverride "bg_estates_frame_margins" {
																		margin_left = 8
																		margin_right = 8
																		margin_top = 7
																		margin_bottom = 4
																	}
																	hbox = {
																		spacing = 16
																		maximumsize = {430 28}
																		position = {10 0}
																		hbox = {
																			country_flag_small = {}							
																			vbox = {
																				minimumsize = { 78 -1 }
																				maximumsize = { 78 -1 }
																				text_single = {
																					layoutpolicy_horizontal = expanding
																					maximumsize = { 100 38 }
																					multiline = yes
																					text = "[Country.GetNameWithNoTooltip]"
																				}
																				text_single = {
																					layoutpolicy_horizontal = expanding
																					visible = "[Not(ObjectsEqual(Country.Self, InternationalOrganizationsView.GetPlayer.GetCapital.GetOwner.Self))]"
																					text = "[Country.GetDiplomacy.GetOpinionOf(InternationalOrganizationsView.GetPlayer)|+=]"
																					tooltipwidget = {
																						SimpleContextualStringPairTooltipType = {
																							blockoverride "title_icon" {
																								icon = {
																									using = tooltip_title_icon_size
																									texture = "gfx/interface/icons/flat_icons/foreigncountry/opinion.dds"
																								}
																							}
																							blockoverride "concept_link" {
																								text = "[opinion|e]"
																							}
																							tooltipmeta = {
																								texture = "gfx/interface/icons/flat_icons/foreigncountry/opinion.dds"
																								game_concept = "[opinion|E]"
																							}
																							lowpriotextcontext = "[Country.GetDiplomacy.GetOpinionDescription(InternationalOrganizationsView.GetPlayer)]"
																						}
																					}
																				}
																				text_single = {
																					layoutpolicy_horizontal = expanding
																					visible = "[ObjectsEqual(Country.Self, InternationalOrganizationsView.GetPlayer.GetCapital.GetOwner.Self)]"
																					raw_text = "0.00"
																				}
																				text_single = {
																					layoutpolicy_horizontal = expanding
																					visible = "[Country.HasSpecialStatus(InternationalOrganizationsView.GetInternationalOrganization,'senior_partner')]"
																					text = "senior_partner"
																				}
																				expand = {}
																			}
																		}
																		vbox = {
																			maximumsize = { 60 -1 }
																			margin_top = 2
																			spacing = 5
																			# THEIR STABILITY
																			hbox = {
																				spacing = 3
																				text_single = {
																					layoutpolicy_horizontal = expanding
																					size = { -1 15 }
																					align = right
																					minimumsize = { 43 -1 }
																					raw_text = "[Country.GetCurrencyValue('stability')]"
																					using = Font_Size_Small
																				}
																				piechart = {
																					size = { 22 22 }
																					using = piechart_angles
																					datacontext = "[Country]"
																					icon = {
																						texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
																						size = { 97% 97% }
																						parentanchor = center
																						color = { 0.45 0.59  0.67 1 }
																						alpha = 0.3
																					}
																					pieslice = {
																						texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
																						value = "[FixedPointToFloat(Country.GetFixedPointCurrencyValue('stability'))]"
																						color = { 0.3 0.8 0.3 1 }
																						alpha = 0.8
																					}
																					pieslice = {
																						texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
																						value = "[Subtract_float('(float)100.0', FixedPointToFloat(Country.GetFixedPointCurrencyValue('stability')))]"
																						color = { 1 1 1 0 }
																					}
																					icon = {
																						using = icon_stability
																						size = { 70% 70% }
																						# using = overlay_color_light_blue
																						parentanchor = center
																					}
																					using = bg_circle_piechart
																				}
																				tooltipwidget = {
																					using = StabilityResourceTooltip
																					blockoverride "content_datacontext" {
																						datacontext = "[Country.GetEconomy]"
																					}
																					# blockoverride "change_visibility" { visible = no } # FOREIGN_CHANGE_VISIBLE
																				}
																			}

																			# THEIR LEGITIMACY
																			hbox = {
																				spacing = 3
																				text_single = {
																					layoutpolicy_horizontal = expanding
																					size = { -1 15 }
																					align = right
																					minimumsize = { 43 -1 }
																					raw_text = "[Country.GetCurrencyValue('legitimacy')]"
													
																					using = Font_Size_Small
																				}
																				piechart = {
																					size = { 22 22 }

																					using = piechart_angles
																					datacontext = "[Country]"

																					icon = {
																						texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
																						size = { 97% 97% }
																						parentanchor = center
																						color = { 0.45 0.59  0.67 1 }
																						alpha = 0.3
																					}

																					pieslice = {
																						texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
																						value = "[FixedPointToFloat(Country.GetFixedPointCurrencyValue('legitimacy'))]"
																						color = { 0.3 0.8 0.3 1 }
																						alpha = 0.8
																					}

																					pieslice = {
																						texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
																						value = "[Subtract_float('(float)100.0', FixedPointToFloat(Country.GetFixedPointCurrencyValue('legitimacy')))]"
																						color = { 1 1 1 0 }
																					}

																					icon = {
																						texture = "[GetLegitimacyIcon(Country.GetGovernment.GetGovernmentType)]"
																						size = { 70% 70% }
																						parentanchor = center
																					}
																					using = bg_circle_piechart
																				}
																				tooltipwidget = {
