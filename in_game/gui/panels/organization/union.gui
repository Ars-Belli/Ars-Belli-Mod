				spacing = 4
				widget = {
					layoutpolicy_horizontal = expanding
					size = { -1 36 }
					visible = "[InternationalOrganizationsView.HasCommonLaws]"
					using = bg_card_header_01_diplomacy
					using = bg_cabinet_card_frame

					background = {
						visible = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('iberian_union_active').IsSet]"
						texture = "gfx/interface/component_decoration/ios/union/iberian_union/union_header_2.dds"
						texture_density = 2
						spriteType = corneredstretched
						spriteborder = { 45 0 }
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 16 0 }
						spacing = 10

						icon = {
							size = { 22 22 }
							texture = "gfx/interface/icons/flat_icons/laws.dds"
							texture_density = 2
						}
						text_single = {
							align = left|nobaseline
							autoresize = yes
							default_format = "#yellow_titles"
							text = "UNION_COMMON_LAWS_HEADER"
						}
						expand = {}
					}
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 2
					visible = "[InternationalOrganizationsView.HasCommonLaws]"
					datamodel = "[InternationalOrganizationsView.GetCommonLaws]"
					item = {
						union_common_law_item = {}
					}
				}
			}
		}
	}

	blockoverride "scroll_list_is_empty_text_position" {
		position = { 0 250 }
	}

