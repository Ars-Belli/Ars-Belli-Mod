situation_panel = {
	blockoverride "situation_panel_main_content" {
		situation_card_common = {
			blockoverride "common_header_icon_texture" {
				texture = "[SituationView.GetActiveSituation.GetIcon]"
			}
			blockoverride "common_header_text_full" {
				text_single = {
					text = "SSG_RESTORATION_PILLARS"
				}
			}
			blockoverride "common_bottom_content" {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 5

					text_multi = {
						layoutpolicy_horizontal = expanding
						max_width = 400
						autoresize = yes
						text = "ssg_hanyang_jo_restoration_desc"
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 3

						text_single = {
							text = "SSG_ACTIVE_PROJECT"
							default_format = "#yellow_titles"
						}
						text_single = {
							visible = "[Not(Player.MakeScope.GetVariable('ssg_active_project').IsSet)]"
							text = "SSG_NO_ACTIVE_PROJECT"
						}

						flowcontainer = {
							layoutpolicy_horizontal = expanding
							ignoreinvisible = yes
							visible = "[Player.MakeScope.GetVariable('ssg_active_project').IsSet]"
							datamodel = "[Player.GetTimedModifiers]"
							item = {
								hbox = {
									datacontext = "[TimedModifier]"
									layoutpolicy_horizontal = expanding
									spacing = 8
									visible = "[EqualTo_string(TimedModifier.GetModifier.GetNameWithNoTooltip, Localize('STATIC_MODIFIER_NAME_ssg_national_project_underway'))]"

									timed_modifier_icon = {
										datacontext = "[TimedModifier]"
										size = { 32 32 }
									}

									vbox = {
										layoutpolicy_horizontal = expanding
										text_single = { visible = "[Player.MakeScope.GetVariable('ssg_active_restore_royal_granaries').IsSet]" text = "ssg_restore_royal_granaries" }
										text_single = { visible = "[Player.MakeScope.GetVariable('ssg_active_link_the_mountain_valleys').IsSet]" text = "ssg_link_the_mountain_valleys" }
										text_single = { visible = "[Player.MakeScope.GetVariable('ssg_active_establish_frontier_workshops').IsSet]" text = "ssg_establish_frontier_workshops" }
										text_single = { visible = "[Player.MakeScope.GetVariable('ssg_active_organize_frontier_musters').IsSet]" text = "ssg_organize_frontier_musters" }
										text_single = { visible = "[Player.MakeScope.GetVariable('ssg_active_raise_beacons_and_forts').IsSet]" text = "ssg_raise_beacons_and_forts" }
										text_single = { visible = "[Player.MakeScope.GetVariable('ssg_active_build_the_royal_arsenal').IsSet]" text = "ssg_build_the_royal_arsenal" }
										text_single = { visible = "[Player.MakeScope.GetVariable('ssg_active_acquire_foreign_manuscripts').IsSet]" text = "ssg_acquire_foreign_manuscripts" }
										text_single = { visible = "[Player.MakeScope.GetVariable('ssg_active_found_experimental_workshops').IsSet]" text = "ssg_found_experimental_workshops" }
										text_single = { visible = "[Player.MakeScope.GetVariable('ssg_active_open_the_court_academy').IsSet]" text = "ssg_open_the_court_academy" }
										text_single = { visible = "[Player.MakeScope.GetVariable('ssg_active_choose_the_frontier_posture').IsSet]" text = "ssg_choose_the_frontier_posture" }
										text_single = { visible = "[Player.MakeScope.GetVariable('ssg_active_authorize_privy_merchants').IsSet]" text = "ssg_authorize_privy_merchants" }
										text_single = { visible = "[Player.MakeScope.GetVariable('ssg_active_press_restoration_claims').IsSet]" text = "ssg_press_restoration_claims" }
										text_single = { visible = "[Not(Player.MakeScope.GetVariable('ssg_project_midpoint').IsSet)]" text = "SSG_PROJECT_PHASE_EARLY" }
										text_single = { visible = "[Player.MakeScope.GetVariable('ssg_project_midpoint').IsSet]" text = "SSG_PROJECT_PHASE_LATE" }
										text_single = { text = "[TimedModifier.GetDuration]" }
										text_single = { text = "SSG_PROJECT_TIMER_HINT" }
									}
								}
							}
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						minimumsize = { -1 24 }
						text_single = { text = "SSG_ECONOMY_PILLAR" }
						expand = {}
						text_single = {
							visible = "[Not(Player.MakeScope.GetVariable('ssg_economy_stage_1').IsSet)]"
							text = "SSG_PILLAR_NOT_STARTED"
						}
						text_single = {
							visible = "[And(Player.MakeScope.GetVariable('ssg_economy_stage_1').IsSet, Not(Player.MakeScope.GetVariable('ssg_economy_stage_2').IsSet))]"
							text = "SSG_PILLAR_STAGE_1"
						}
						text_single = {
							visible = "[And(Player.MakeScope.GetVariable('ssg_economy_stage_2').IsSet, Not(Player.MakeScope.GetVariable('ssg_economy_complete').IsSet))]"
							text = "SSG_ECONOMY_PILLAR_STAGE_2"
						}
						text_single = {
							visible = "[Player.MakeScope.GetVariable('ssg_economy_complete').IsSet]"
							text = "SSG_PILLAR_COMPLETE"
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						minimumsize = { -1 24 }
						text_single = { text = "SSG_MILITARY_PILLAR" }
						expand = {}
						text_single = {
							visible = "[Not(Player.MakeScope.GetVariable('ssg_military_stage_1').IsSet)]"
							text = "SSG_PILLAR_NOT_STARTED"
						}
						text_single = {
							visible = "[And(Player.MakeScope.GetVariable('ssg_military_stage_1').IsSet, Not(Player.MakeScope.GetVariable('ssg_military_stage_2').IsSet))]"
							text = "SSG_PILLAR_STAGE_1"
						}
						text_single = {
							visible = "[And(Player.MakeScope.GetVariable('ssg_military_stage_2').IsSet, Not(Player.MakeScope.GetVariable('ssg_military_complete').IsSet))]"
							text = "SSG_MILITARY_PILLAR_STAGE_2"
						}
						text_single = {
							visible = "[Player.MakeScope.GetVariable('ssg_military_complete').IsSet]"
							text = "SSG_PILLAR_COMPLETE"
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						minimumsize = { -1 24 }
						text_single = { text = "SSG_RESEARCH_PILLAR" }
						expand = {}
						text_single = {
							visible = "[Not(Player.MakeScope.GetVariable('ssg_research_stage_1').IsSet)]"
							text = "SSG_PILLAR_NOT_STARTED"
						}
						text_single = {
							visible = "[And(Player.MakeScope.GetVariable('ssg_research_stage_1').IsSet, Not(Player.MakeScope.GetVariable('ssg_research_stage_2').IsSet))]"
							text = "SSG_PILLAR_STAGE_1"
						}
						text_single = {
							visible = "[And(Player.MakeScope.GetVariable('ssg_research_stage_2').IsSet, Not(Player.MakeScope.GetVariable('ssg_research_complete').IsSet))]"
							text = "SSG_RESEARCH_PILLAR_STAGE_2"
						}
						text_single = {
							visible = "[Player.MakeScope.GetVariable('ssg_research_complete').IsSet]"
							text = "SSG_PILLAR_COMPLETE"
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						minimumsize = { -1 24 }
						text_single = { text = "SSG_DIPLOMACY_PILLAR" }
						expand = {}
						text_single = {
							visible = "[Not(Player.MakeScope.GetVariable('ssg_diplomacy_stage_1').IsSet)]"
							text = "SSG_PILLAR_NOT_STARTED"
						}
						text_single = {
							visible = "[And(Player.MakeScope.GetVariable('ssg_diplomacy_stage_1').IsSet, Not(Player.MakeScope.GetVariable('ssg_diplomacy_stage_2').IsSet))]"
							text = "SSG_PILLAR_STAGE_1"
						}
						text_single = {
							visible = "[And(Player.MakeScope.GetVariable('ssg_diplomacy_stage_2').IsSet, Not(Player.MakeScope.GetVariable('ssg_diplomacy_complete').IsSet))]"
							text = "SSG_DIPLOMACY_PILLAR_STAGE_2"
						}
						text_single = {
							visible = "[Player.MakeScope.GetVariable('ssg_diplomacy_complete').IsSet]"
							text = "SSG_PILLAR_COMPLETE"
						}
					}
				}
			}
		}
	}
}
