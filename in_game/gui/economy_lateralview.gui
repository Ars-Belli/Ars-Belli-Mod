
types EconomyLateralviewTypes
{
	type budget_card = widget {
		background = {
			using = tile_card_bg_texture
			alpha = 0.5

			# block "background_color" {
				using = color_dark_blue
			# }

			modify_texture = {
				using = overlay_stone_texture
				blend_mode = overlay
				alpha = 0.3
			}
		}

		hbox = {
			margin = { 5 0 }
			spacing = 5
			using = bg_paper_card

			icon = {
				size = { 24 24 }
				block "icon_texture" {
					texture = "gfx/interface/icons/flat_icons/balance/others.dds"
				}

				texture_density = 2
			}

			text_single = {
				default_format = "#explanation_link"
				using = layoutpolicy_expanding
				autoresize = no
				align = left|nobaseline
				block "label" {
					text = ""
				}
			}
			
			text_single = {
				autoresize = yes
				align = right|nobaseline
				block "income_text" {
					raw_text = ""
				}
			}
		}
	}

	type adjustable_budget_card = widget {
		using = bg_paper_card
		vbox = {
			widget = {
				using = layoutpolicy_expanding
				block "adjustable_card_header_bg"{
					using = bg_card_header_01
				}
				
				block "top_widget" {}
				block "budget_card_frame" {
					using = bg_cabinet_card_frame
				}
			}

			widget = {
				using = layoutpolicy_expanding
				block "bottom_widget" {}
			}
		}
	}

	type economy_slider = ranged_slider {
		direction = horizontal
		allow_outside = yes

		step = 0.01
		wheelstep = 0.01

		# block "track_type"{
			track = { using = economy_slider_track }
		# }
		track_range = { # Available progress
			using = economy_slider_track_range
		}

		track_highlight = { # Active Progress
			using = economy_slider_track_highlight
		}

		slider = {
			using = economy_slider_slider
		}

		dec_button = {
			using = economy_slider_dec_button

			# blockoverride "economy_slider_dec_button_config"{
			#	
			#	alpha = 0
			#
			#	state = {
			#		name = show_slider_buttons
			#		alpha = 1
			#		position_x = 0
			#		duration = 0.25
			#		using = Animation_Curve_Default
			#	}
			#	state = {
			#		name = hide_slider_buttons
			#		alpha = 0
			#		position_x = -5
			#		duration = 0.25
			#		using = Animation_Curve_Default
			#	}
			# }
		}

		inc_button = {
			using = economy_slider_inc_button

			# blockoverride "economy_slider_inc_button_config"{
			#	alpha = 0
			#	
			#	state = {
			#		name = show_slider_buttons
			#		alpha = 1
			#		position_x = 123
			#		duration = 0.25
			#		using = Animation_Curve_Default
			#	}
			#	state = {
			#		name = hide_slider_buttons
			#		alpha = 0
			#		position_x = 128
			#		duration = 0.25
			#		using = Animation_Curve_Default
			#	}
			# }
		}
	}
}

# template income_card {
# 	blockoverride "background_color" {
# 		using = color_light_blue
# 	}
# }

template economy_main_tabs {
	button_main_tab_alt = {
		layoutpolicy_horizontal = expanding
		tooltipwidget = {
			using = SubTabBalanceTooltip
		}
		widget = {
			visible = "[Not(IsLateralViewOpened('economy'))]"
			size = { 100% 100% }
			name = "tab_balance"
		}
		down = "[IsLateralViewOpened('economy')]"
		datacontext = "[GetAutomatedSystemItem('finances')]"
		using = automated_tab

		blockoverride "on_action_left" { on_action = "[OpenLateralView('economy')]" }
		blockoverride "text" { text = "BALANCE_TEXT" }
	}

	button_main_tab_alt = {
		using = layoutpolicy_expanding
		tooltipwidget = {
			using = SubTabCreditTooltip
		}
		widget = {
			visible = "[Not(IsLateralViewOpened('credit'))]"
			size = { 100% 100% }
			name = "tab_credit"
		}
		down = "[IsLateralViewOpened('credit')]"
		datacontext = "[GetAutomatedSystemItem('credit')]"
		using = automated_tab

		blockoverride "on_action_left" { on_action = "[OpenLateralView('credit')]" }
		blockoverride "text" { text = "lateralview_credit_entry_name" }
	}

	button_main_tab_alt = {
		using = layoutpolicy_expanding
		tooltipwidget = { 
			using = SubTabMarketsTooltip
		}
		widget = {
			visible = "[Not(And(IsLateralViewOpened('trade'), LateralView.Vars.NotExistOrHasValue( 'subtab', 'markets' )))]"
			size = { 100% 100% }
			name = "tab_markets"
		}

		down = "[And(IsLateralViewOpened('trade'), LateralView.Vars.NotExistOrHasValue( 'subtab', 'markets' ))]"
		blockoverride "tab_text" { text = "SUBTAB_TRADE_MARKETS" }
		action_tooltip = {
			title = "OPEN_TAB"
			on_action = "[OpenLateralViewWithParams('trade', 'subtab = markets')]"
		}
	}
	
	

	button_main_tab_alt = {
		using = layoutpolicy_expanding
		enabled = "[Player.HasOwnedMarket]"
		datacontext = "[GetAutomatedSystemItem('TradePolicies')]"
		tooltipwidget = {
			using = SubTabTariffsTooltip
		}
		widget = {
			visible = "[Not(IsLateralViewOpened('trade_policies'))]"
			size = { 100% 100% }
			name = "tab_trade_policies"
		}
		down = "[IsLateralViewOpened('trade_policies')]"
		using = automated_tab

		blockoverride "on_action_left" {
			click_mode = single
			enabled = "[Player.HasOwnedMarket]"
			conditions = "[MakeItFailIfLoc(Not(Player.HasOwnedMarket), 'TRADE_POLICIES_TAB_REQUIRES_MARKET')]"
			on_action = "[OpenLateralView('trade_policies')]"
		}
		blockoverride "text" { text = "lateralview_trade_policies_name" }
	}
	button_main_tab_alt = {
		using = layoutpolicy_expanding
		tooltipwidget = {
			using = SubTabTradingTooltip
		}

		down = "[And(IsLateralViewOpened('trade'), LateralView.Vars.HasValue( 'subtab', 'trades' ))]"
		blockoverride "tab_text" { text = "TRADE_TAB" }
		action_tooltip = {
			title = "OPEN_TAB"
			on_action = "[OpenLateralViewWithParams('trade', 'subtab = trades')]"
		}
	}
}

template EstateIncomeBreakdownTooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			datacontext = "[TaxRateSetting.GetEstate]"
			text = "TAXING_ESTATE_INCOME_BREAKDOWN"
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetEstateIcon(TaxRateSetting.GetEstate.GetType)]"
				
				datacontext = "[TaxRateSetting.GetEstate]"
				tooltipwidget = {
					using = Estate_tooltip
				}
			}
		}

		blockoverride "concept_link" {
			text = [estate_tax_base|E]
		}
		blockoverride "tooltip_content" {
			datacontext = "[TaxRateSetting.GetEstate]"
			TooltipTextBlock = {																						
				blockoverride "text"	{
					text = "ESTATE_CURRENT_TAX_TT"
				}
			}
			
			TooltipStringPairList = {
				visible = "[Not(StringIsEmpty(TaxRateSetting.GetTaxSettingsTooltip))]"
				textcontext = "[TaxRateSetting.GetTaxSettingsTooltip]"
			}

			TooltipTextBlock = {
				visible = "[Not(TaxRateSetting.GetEstate.CanCollectTaxes)]"
				blockoverride "text" {
					text = "[TaxRateSetting.GetEstate.GetCollectTaxesInfo]"
				}
			}
		
			TooltipStringPairList = {
				visible = "[And(TaxRateSetting.GetEstate.CanCollectTaxes, Not(StringIsEmpty(TaxRateSetting.GetIncomeBreakdown)))]"
				textcontext = "[TaxRateSetting.GetIncomeBreakdown]"
			}

			caesar_plotline = {
				visible = "[TaxRateSetting.GetEstate.HasTaxHistory]"
				datacontext = "[TaxRateSetting.GetEstate]"
				layoutpolicy_horizontal = expanding
				size = { -1 180 }

				blockoverride "header" {
					text = "ESTATE_TAX_LAST_YEAR"
				}
				blockoverride "line_color" {
					color = { .9 .9 .9 1.0 }
				}
				blockoverride "line_plotpoints" {
					plotpoints = "[Estate.GetTaxHistoryTrend]"
				}
				blockoverride "tooltip" {
					marker = {
						text_single = {
							position = { 0 -20 }
							autoresize = yes

							margin_right = 4
							margin_top = 4
							align = left|nobaseline
							using = bg_number_container_bckg
							default_format = "#t"

							text = "[Estate.GetTaxDataPointValue(PlotLine.GetSnappedIndexNearMouse)]"
						}
					}
				}
				blockoverride "maxvalue" {
					raw_text = "[Estate.GetMaxTaxForPlot|1]@gold!"
				}
				blockoverride "minvalue" {
					raw_text = "[Estate.GetMinTaxForPlot|1]@gold!"
				}
				blockoverride "startdate" {
					text = "[Estate.GetTaxHistoryStartDate]"
				}
				blockoverride "enddate" {
					text = "[Estate.GetTaxHistoryEndDate]"
				}
				blockoverride "multiitem" {}
			}
		}
	}
}


lateralview = {
	name = "economy_lateralview"
	widgetid = "economy_lateralview"

	blockoverride "lateralview_topbuttons_extra" {
		widget = {
			parentanchor = vcenter
			size = { 40 40 }
			position = { 30 0 }

			button_automation_shortcut = {
				parentanchor = vcenter
				size = { 25 25 }

				action_tooltip = {
					title = "OPEN_AUTOMATION_PANEL_FILTER"
					on_action = "[OpenLateralViewWithFilter('automation', 'automation_filter_economy')]"
				}

				tooltipwidget = { BasicFunctionalTooltip = {} }
			}
		}

		widget = {
			parentanchor = right|vcenter
			size = { 40 40 }
			position = { -30 0 }

			button_minimize = {
				visible = "[Not(LateralView.Vars.Exists('graph_hide'))]"
				parentanchor = right|vcenter

				action_tooltip = {
					title = "HIDE_ECONOMY_CHART"
					on_action = "[LateralView.Vars.Toggle('graph_hide')]"
				}
			}

			button_minimize = {
				visible = "[LateralView.Vars.Exists('graph_hide')]"
				parentanchor = right|vcenter

				blockoverride "button_texture" {
					using = max_button_alt_texture
				}

				action_tooltip = {
					title = "SHOW_ECONOMY_CHART"
					on_action = "[LateralView.Vars.Toggle('graph_hide')]"
				}
			}
		}
	}

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "THE_ECONOMY_OVERVIEW_TITLE"
			}
			blockoverride "window_header_alt_color_texture"{
				using = color_economy_texture
			}
		}
	}

	blockoverride "panel_content" {
		header_main_tabs = {
			blockoverride "content" {
				using = economy_main_tabs
			}
		}

		vbox = {
			using = layoutpolicy_expanding
			using = bg_main_inner_alt
			using = window_main_tabs_margin_alt
			spacing = 3

			AutomatedSection = {
				datacontext = "[GetAutomatedSystemItem('finances')]"
				
				blockoverride "glow_anim_automation_visible" {
					visible = "[AutomatedSystemsItem.IsEnabled]"
				}
			}

			# Initialize satisfaction target variables (default 50%) when economy view is opened
			overlappingitembox = {
				visible = no
				state = {
					name = taxing_initial_init
					trigger_on_create = yes
					next = taxing_init
					on_finish = "[PdxGuiWidget.TriggerAnimation('taxing_init')]"
				}
				state = {
					name = taxing_init
					duration = 1
					on_start = "[PdxGuiWidget.Hide]"
					on_finish = "[GetScriptedGui('taxing_setup').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					next = taxing_init
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				minimumsize = { -1 50 }
				margin = { 4 4 }
				spacing = 4
				using = bg_paper_card
				using = bg_cabinet_card_frame

				tooltipmeta = {
					texture = "[GetConceptTexture('wealth')]"
				}
				hbox = {
					using = layoutpolicy_expanding
					using = bg_text_mask_container_brown
					datacontext = "[Player]"
					spacing = 3
					margin = { 2 2 }

					tooltipwidget = {
						using = EconomicalBaseTooltip
					}

					icon = {
						size = { 20 20 }
						texture = "[GetConceptTexture('economical_base')]"
						glow = {
							name = "drop_shadow"
							glow_radius = 3
							color = { 0.0 0.0 0.0 1.0 }
							alpha = 0.3
						}
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							size = { -1 15 }
							fontsize = 11
							default_format = "#explanation_link"
							align = top|left
							text = "game_concept_economical_base"
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							size = { -1 17 }
							fontsize = 12
							align = left|nobaseline
							text = "[Player.GetEconomicalBase|L2]"
						}
					}
				}
				hbox = {
					using = layoutpolicy_expanding
					using = bg_text_mask_container_brown
					datacontext = "[Player]"
					spacing = 3
					margin = { 2 2 }

					blockoverride "text_mask_extra" {
						alpha = 0.1
					}

					tooltipwidget = {
						using = TotalWealthTooltip
					}

					icon = {
						size = { 20 20 }
						texture = "[GetConceptTexture('wealth')]"
						glow = {
							name = "drop_shadow"
							glow_radius = 3
							color = { 0.0 0.0 0.0 1.0 }
							alpha = 0.3
						}
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							size = { -1 15 }
							fontsize = 11
							default_format = "#explanation_link"
							align = top|left
							text = "game_concept_wealth"
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							size = { -1 17 }
							fontsize = 12
							align = left|nobaseline
							text = "[Player.GetTotalWealth|2L]"
						}
					}
				}
				hbox = {
					name = "tax_base"
					using = layoutpolicy_expanding
					using = bg_text_mask_container_brown
					datacontext = "[Player]"
					spacing = 3
					margin = { 2 2 }

					tooltipwidget = {
						using = TaxBaseTooltip
					}

					icon = {
						size = { 20 20 }
						texture = "[GetConceptTexture('tax_base')]"
						glow = {
							name = "drop_shadow"
							glow_radius = 3
							color = { 0.0 0.0 0.0 1.0 }
							alpha = 0.3
						}
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							size = { -1 15 }
							fontsize = 11
							default_format = "#explanation_link"
							align = top|left
							text = "game_concept_tax_base"
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							size = { -1 17 }
							fontsize = 12
							align = left|nobaseline
							text = "[Player.GetTotalTaxBase]"
						}
					}
				}
				button = {
					using = layoutpolicy_expanding
					using = bg_text_mask_container_brown
					datacontext = "[Player]"

					blockoverride "text_mask_extra" {
						alpha = 0.1
					}

					tooltipwidget = {
						using = TaxBaseWealthRatioTooltip
					}

					action_tooltip = {
						click_type = left
						click_mode = single
						title = "TAX_BASE_WEALTH_RATIO_BUILD_CONTROL"
						on_action = "[ShowProductionViewWithFilterAndNoMarket('local_max_control', '(bool)yes')]"
						on_action = "[ShowProductionViewWithFilter('global_max_control', '(bool)no')]"
					}

					hbox = {
						size = { 100% 100% }
						spacing = 3
						margin = { 2 2 }

						icon = {
							size = { 20 20 }
							texture = "gfx/interface/icons/flat_icons/balance/efficiency.dds"
							glow = {
								name = "drop_shadow"
								glow_radius = 3
								color = { 0.0 0.0 0.0 1.0 }
								alpha = 0.3
							}
						}
						vbox = {
							layoutpolicy_horizontal = expanding
							text_single = {
								layoutpolicy_horizontal = expanding
								autoresize = no
								size = { -1 15 }
								fontsize = 11
								default_format = "#explanation_link"
								align = top|left
								text = "game_concept_tax_base_ratio"
							}
							text_single = {
								layoutpolicy_horizontal = expanding
								autoresize = no
								size = { -1 17 }
								fontsize = 12
								align = left|nobaseline
								text = "[Player.GetTaxBaseWealthRatioColored]"
							}
						}
					}
				}
				hbox = {
					using = layoutpolicy_expanding
					using = bg_text_mask_container_brown
					datacontext = "[Player]"
					spacing = 3
					margin = { 2 2 }

					tooltipwidget = {
						using = TaxEfficiencyTooltip
					}

					icon = {
						size = { 20 20 }
						texture = "gfx/interface/icons/flat_icons/balance/tax_efficiency.dds"
						glow = {
							name = "drop_shadow"
							glow_radius = 3
							color = { 0.0 0.0 0.0 1.0 }
							alpha = 0.3
						}
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							size = { -1 15 }
							fontsize = 11
							default_format = "#explanation_link"
							align = top|left
							text = "game_concept_tax_efficiency"
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							size = { -1 17 }
							fontsize = 12
							align = left|nobaseline
							text = "[Player.GetModifierValueNoFormat('tax_income_efficiency')]"
						}
					}
				}
			}

			economy_plotline = {
				visible = "[Not(LateralView.Vars.Exists('graph_hide'))]"
				using = bg_age_event_frame
				
				blockoverride "size" {
					layoutpolicy_horizontal = expanding
					size = { -1 220 }
				}
				blockoverride "background" {
					using = bg_text_mask_container_dark_brown

					background = {
						texture = "gfx/interface/illustrations/institutions/banking.dds"
						frame_grid = {1 2}
						frame = 2
						fittype = centercrop
						alpha = 0.4
					}

					background = {
						using = color_default_brown_texture
						alpha = 0.8
						modify_texture = {
							using = overlay_paper_03
						}
					}

					background = {
						using = color_black_texture
						alpha = 0.4
						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_corners_bottom.dds"
							texture_density = 2
							spriteType = corneredstretched
							spriteborder = { 20 20 }
							blend_mode = alphamultiply
							alpha = 0.9
						}
						
					}

					background = {
						using = color_black_texture
						alpha = 0.3
						modify_texture = {
							texture = "gfx/interface/component_masks/overview_mask.dds"
							texture_density = 2
							spriteType = corneredstretched
							spriteborder = { 20 20 }
							blend_mode = alphamultiply
							alpha = 0.7
						}
					}
					
					background = {
						using = plotchart_grid_texture
						alpha = 0.5

						modify_texture = {
							using = color_super_dark_brown_texture
							blend_mode = add
							alpha = 0.7
						}
						modify_texture = {
							using = color_super_dark_brown_texture
							blend_mode = overlay
						}
					}

				}
				blockoverride "graph_fade_background" {}
				blockoverride "line_width" {
					width = 3
				}
				blockoverride "header" {
					# raw_text = "[balance|e]: [EconomyView.GetEstimatedBalance|2+=]@gold!"
				}
				blockoverride "line_color" {
					color = { 0.30 0.75 0.35 1.0 }
				}
				blockoverride "line_plotpoints" {
					plotpoints = "[EconomyView.GetRecentIncome]"
				}
				blockoverride "tooltip" {
					using = tooltip_se
					tooltipwidget = {
						BasicFunctionalTooltip = {
							alwaystransparent = yes
							blockoverride "tooltip_content" {
								TooltipBlockList = {
									textcontext = "[EconomyView.GetDataPointValue(PlotLine.GetSnappedIndexNearMouse)]"
								}
							}

							blockoverride "tooltip_minimumsize" { 
								minimumsize = { -1 -1 }
							}
						}
					}
				}
				blockoverride "maxvalue" {
					position = { 0 0 }
					align = right|nobaseline
					raw_text = "[EconomyView.GetHistoricalMaxAmount|2L]@gold!"
					tooltipwidget = {
						SimpleContextualStringPairTooltipType = {
							blockoverride "title_icon_texture" {
								texture = "[GetConceptTexture('income')]"
							}

							blockoverride "concept_link" {
								text = "[income|e]"
							}

							lowpriotextcontext = "[EconomyView.GetHistoricalMaxAmountTooltip]"
						}
					}
				}
				blockoverride "minvalue" {
					position = { 0 0 }
					align = right|nobaseline
					raw_text = "0@gold!"
				}
				blockoverride "datamodel" {
					size = { 99% 80% }
				}
				blockoverride "startdate" {
					text = "[EconomyView.GetGraphStartDate]"
					# visible = no
				}
				blockoverride "enddate" {
					text = "[EconomyView.GetGraphEndDate]"
					# visible = no
				}
				blockoverride "multiitem" {}

				blockoverride "extra_plotlines" {
					plotline = {
						size = { 100% 100% }
						using = plot_line
						width = 3
						color = { 0.85 0.25 0.25 1.0 }
						plotpoints = "[EconomyView.GetRecentExpense]"

						using = tooltip_se
						tooltipwidget = {
							BasicFunctionalTooltip = {
								alwaystransparent = yes
								blockoverride "tooltip_content" {
									TooltipBlockList = {
										textcontext = "[EconomyView.GetDataPointValue(PlotLine.GetSnappedIndexNearMouse)]"
									}
								}

								blockoverride "tooltip_minimumsize" { 
									minimumsize = { -1 -1 }
								}
							}
						}
					}
				}

				blockoverride "empty_state_visibility" {}

				blockoverride "empty_state_text" {}


