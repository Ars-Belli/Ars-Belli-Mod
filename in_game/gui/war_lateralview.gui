template sue_for_peace_action_tooltip {	
	tooltipwidget = {
		ContextualTooltipType = {
			blockoverride "title_icon_texture" {
				texture = "gfx/interface/icons/flat_icons/war_view/offer_peace_button.dds"
			}
		
			blockoverride "title_text" {										
				text = "PEACETITLE"
			}
								
			blockoverride "concept_link" {
				text = [peace|E]
			}
		
			blockoverride "tooltip_content" {
				TooltipTextBlock = {
					visible = "[And(WarLateralView.TogglePeaceViewEnabled, Not(StringIsEmpty(WarLateralView.TogglePeaceViewTooltip)))]"
					blockoverride "text" {
						text = "[WarLateralView.TogglePeaceViewTooltip]"
					}
				}
				TooltipRequirementsList = {					
					visible = "[Not(StringIsEmpty(StringToConditionListOnlyPassedAndNeutralIfNot(And(WarLateralView.TogglePeaceViewEnabled, StringIsEmpty(WarLateralView.TogglePeaceViewTooltip)), WarLateralView.TogglePeaceViewTooltip).GetOutput))]"
					textcontext = "[StringToConditionListOnlyPassedAndNeutralIfNot(And(WarLateralView.TogglePeaceViewEnabled, StringIsEmpty(WarLateralView.TogglePeaceViewTooltip)), WarLateralView.TogglePeaceViewTooltip).GetOutput]"
				}
			}
		}
	}
}

# Ars Belli: tooltip for the Enforce Peace button. Each requirement resolves to a
# passed or failed loc line so a player who cannot use the action is told why,
# rather than the button simply disappearing.
template ars_belli_enforce_peace_tooltip {
	tooltipwidget = {
		ContextualTooltipType = {
			blockoverride "title_icon_texture" {
				texture = "gfx/interface/icons/flat_icons/war_view/enforce_peace_button.dds"
			}

			blockoverride "title_text" {
				text = "ars_belli_enforce_peace"
			}

			blockoverride "concept_link" {
				text = [peace|E]
			}

			blockoverride "tooltip_content" {
				TooltipTextBlock = {
					blockoverride "text" {
						text = "ars_belli_enforce_peace_desc"
					}
				}
				TooltipTextBlock = {
					blockoverride "text" {
						text = "[SelectLocalization(Not(WarLateralView.IsPlayerInWar), 'ars_belli_ep_req_not_participant_met', 'ars_belli_ep_req_not_participant_unmet')]"
					}
				}
				TooltipTextBlock = {
					blockoverride "text" {
						text = "[SelectLocalization(Or4(Player.MakeScope.GetVariable('mp_is_gp').IsSet, Player.MakeScope.GetVariable('mp_is_major').IsSet, Player.GetDiplomacy.IsRival(WarLateralView.GetEnemyLeader), Player.GetDiplomacy.IsRival(WarLateralView.GetFriendlyLeader)), 'ars_belli_ep_req_standing_met', 'ars_belli_ep_req_standing_unmet')]"
					}
				}
			}
		}
	}
}
