											}				
										}
									}
								}
								# blockoverride "wax_color" {
								# 	using = color_mid_bright_blue
								# }

								hbox = {
									spacing = 5
									expand = {}

									icon = {
										size = {25 25}
										texture = "gfx/interface/icons/treaty_type/grant_independence.dds"

										glow = {
											name = "drop_shadow"
											glow_radius = 3
											color = {0.0 0.0 0.0 1.0}
											alpha = 0.6
										}
									}

									text_single = {
										text = "WAR_LATERALVIEW_GRANT_INDEPENDENCE"
										align = nobaseline
										using = Font_Type_Headers
									}

									expand = {}
								}
							}

							# REIN IN SUBJECT
							button_wax = {
								layoutpolicy_horizontal = expanding
								visible = "[WarLateralView.IsReinInSubjectVisible]"
								onclick = "[WarLateralView.ShowPeaceDemandLateralView]"

								tooltipwidget = {
									ContextualTooltipType = {
										blockoverride "title_icon" {
											icon = {
												using = tooltip_title_icon_size
												texture = "gfx/interface/icons/peace_treaty/offer_peace.dds"

												glow = {
													name = "drop_shadow"
													glow_radius = 3
													color = {0.0 0.0 0.0 1.0}
													alpha = 0.3
												}
											}
										}

										blockoverride "title_text" {
											text = "WAR_LATERALVIEW_REIN_IN_SUBJECT"
										}

										blockoverride "concept_link" {
											text = "[peace|e]"
										}

										blockoverride "tooltip_content" {
											TooltipScrolledRowList = {
												blockoverride "block_scrollarea" { maximumsize = { -1 350 } }
												textcontext = "[WarLateralView.GetReinInSubjectTooltip]"
												ontextcontextchanged = "[SetRowListWithTitleFromTextContext(PdxGuiWidget.AccessSelf)]"
											}
										}
									}
								}

								hbox = {
									spacing = 5
									expand = {}

									icon = {
										size = {25 25}
										texture = "gfx/interface/icons/peace_treaty/offer_peace.dds"

										glow = {
											name = "drop_shadow"
											glow_radius = 3
											color = {0.0 0.0 0.0 1.0}
											alpha = 0.6
										}
									}

									text_single = {
										text = "WAR_LATERALVIEW_REIN_IN_SUBJECT"
										align = nobaseline
										using = Font_Type_Headers
									}

									expand = {}
								}
							}

							#Attacker Surrender
							button_wax = {
								layoutpolicy_horizontal = expanding
								size = { -1 50 }
								visible = "[WarLateralView.IsAttackerUnconditionalSurrenderVisible]"
								enabled = "[WarLateralView.GetAttackerUnconditionalSurrender.IsEnabled]"
								action_tooltip = {
									click_type = left
									click_mode = confirm
									title = "[WarLateralView.GetAttackerUnconditionalSurrender.GetTitle]"
									on_action = "[WarLateralView.GetAttackerUnconditionalSurrender.OnClick]"
									visible = "[WarLateralView.IsAttackerUnconditionalSurrenderVisible]"
									enabled = "[WarLateralView.GetAttackerUnconditionalSurrender.IsEnabled]"
									description = "[WarLateralView.GetAttackerUnconditionalSurrender.GetTooltip]"
								}		
								
								tooltipwidget = { BasicFunctionalTooltip = {} }
									
								hbox = {
									spacing = 5
									expand = {}
				
									text_single = {
										text = "[WarLateralView.GetAttackerUnconditionalSurrender.GetTitle]"
										align = nobaseline
										using = Font_Type_Headers
									}
				
									icon = {
										size = {20 20}
										texture = "gfx/interface/icons/flat_icons/war_view/offer_peace_button.dds"
									}
				
									expand = {}
								}
							}
						}
					}

					expand = {}
				}
			}
		}
	}
}

template white_peace_tooltip {	
	tooltipwidget = {
		ContextualTooltipType = {
			blockoverride "title_icon" {
				icon = {
					using = tooltip_title_icon_size
					texture = "gfx/interface/icons/alerts_icons/alert_they_can_white_peace.dds"
				}
			}
		
			blockoverride "title_text" {										
				text = "WHITE_PEACE"
			}
								
			blockoverride "concept_link" {
				text = [white_peace|E]
			}
		
			blockoverride "tooltip_content" {
				TooltipTextBlock = {
					blockoverride "text" {
						text = "[WarLateralView.WhitePeaceDesc]"
					}
				}
			}
		}
	}
}

