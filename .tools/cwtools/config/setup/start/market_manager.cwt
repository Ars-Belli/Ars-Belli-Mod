types = {
    ## type_key_filter = market_manager
    type[market_manager] = {
        path = "setup/start"
        path = "in_game/setup/start"
        path = "main_menu/setup/start"
        path = "loading_screen/setup/start"
        path_extension = .txt
    }
}

market_manager = {
    ## cardinality = 0..inf
    add_market = value[location]
}
