types = {
    ## type_key_filter = colony_manager
    type[colony_manager] = {
        path = "setup/start"
        path = "in_game/setup/start"
        path = "main_menu/setup/start"
        path = "loading_screen/setup/start"
        path_extension = .txt
        unique = no
    }
}

colony_manager = {
    ## cardinality = 0..inf
    <province> = {
        tag = <country>

        category = enum[colonial_claim_category]

        reason = localisation
    }
}
