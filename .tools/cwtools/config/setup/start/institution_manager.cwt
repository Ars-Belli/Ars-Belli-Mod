types = {
    type[institution_manager] = {
        path = "setup/start"
        path = "in_game/setup/start"
        path = "main_menu/setup/start"
        path = "loading_screen/setup/start"
        path_extension = .txt
        unique = no
        skip_root_key = {
            institution_manager
        }
    }
}

institution_manager = {
    ## cardinality = 0..inf
    <institution> = {
        active = bool

        birth_place = value[location]
    }
}
