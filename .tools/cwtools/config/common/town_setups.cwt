types = {
    type[town_setup] = {
        path = "common/town_setups"
        path = "in_game/common/town_setups"
        path = "main_menu/common/town_setups"
        path = "loading_screen/common/town_setups"
        path_extension = .txt
    }
}

town_setup = {
    ## cardinality = 0..1
    copy_from = <town_setup>

    ## cardinality = 1..inf
    <building_type> = int
}
