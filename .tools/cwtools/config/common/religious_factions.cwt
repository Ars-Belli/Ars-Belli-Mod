types = {
    type[religious_faction] = {
        path = "common/religious_factions"
        path = "in_game/common/religious_factions"
        path = "main_menu/common/religious_factions"
        path = "loading_screen/common/religious_factions"
        path_extension = .txt
        localisation = {
            name = "$"
            desc = "$_desc"
        }
    }
}

## replace_scope = { root = country this = country }
religious_faction = {
    visible = single_alias_right[trigger_clause]

    enabled = single_alias_right[trigger_clause]

    actions = {
        ## cardinality = 0..inf
        <generic_action>
    }
}
