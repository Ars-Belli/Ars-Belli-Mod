types = {
    type[hegemon] = {
        path = "common/hegemons"
        path = "in_game/common/hegemons"
        path = "main_menu/common/hegemons"
        path = "loading_screen/common/hegemons"
        path_extension = .txt
        localisation = {
            name = "$"
            desc = "$_desc"
        }
    }
}

## replace_scope = { root = country this = country }
hegemon = {
    gain = single_alias_right[trigger_clause]

    lose = single_alias_right[trigger_clause]

    modifier = single_alias_right[modifier_clause]
}
