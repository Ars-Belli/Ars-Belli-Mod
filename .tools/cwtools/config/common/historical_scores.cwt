types = {
    type[historical_score] = {
        path = "common/historical_scores"
        path = "in_game/common/historical_scores"
        path = "main_menu/common/historical_scores"
        path = "loading_screen/common/historical_scores"
        path_extension = .txt
        localisation = {
            name = "$"
            desc = "$_desc"
        }
    }
}

historical_score = {
    tag = <country>
    tag = value[dynamic_tag]

    score = int
}
