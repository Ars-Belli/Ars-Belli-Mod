types = {
    type[scenario] = {
        path = "common/scenarios"
        path = "in_game/common/scenarios"
        path = "main_menu/common/scenarios"
        path = "loading_screen/common/scenarios"
        path_extension = .txt
    }
}

scenario = {
    # TODO: country definition
    country = scalar

    ## cardinality = 0..1
    flag = <coat_of_arm>

    player_playstyle = enum[playstyle_type]
    player_proficiency = enum[scenario_proficiency]
}
