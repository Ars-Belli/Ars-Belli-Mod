types = {
    type[societal_value] = {
        path = "common/societal_values"
        path = "in_game/common/societal_values"
        path = "main_menu/common/societal_values"
        path = "loading_screen/common/societal_values"
        path_extension = .txt
        localisation = {
            name = "$"
            desc = "$_desc"
        }
    }
}

societal_value = {
    ## cardinality = 0..1
    age = <age>

    ## cardinality = 0..1
    content_priority = int

    left_modifier = single_alias_right[modifier_clause]
    right_modifier = single_alias_right[modifier_clause]

    ## cardinality = 0..1
    opinion_importance_multiplier = value_field

    ## cardinality = 0..1
    allow = single_alias_right[trigger_clause]
}
