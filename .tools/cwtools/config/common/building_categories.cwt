types = {
    type[building_category] = {
        path = "common/building_categories"
        path = "in_game/common/building_categories"
        path = "main_menu/common/building_categories"
        path = "loading_screen/common/building_categories"
        path_extension = .txt
        localisation = {
            name = "$"
            desc = "$_desc"
        }
    }
}

building_category = {
    audio_category = enum[audio_category]
}
