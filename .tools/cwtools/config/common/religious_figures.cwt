types = {
    type[religious_figure] = {
        path = "common/religious_figures"
        path = "in_game/common/religious_figures"
        path = "main_menu/common/religious_figures"
        path = "loading_screen/common/religious_figures"
        path_extension = .txt
        localisation = {
            name = "$"
            desc = "$_desc"
        }
    }
}

## replace_scope = { root = religion this = religion }
religious_figure = {
    enabled_for_religion = single_alias_right[trigger_clause]
}
