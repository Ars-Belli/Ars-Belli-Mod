types = {
    type[trait_flavor] = {
        path = "common/trait_flavor"
        path = "in_game/common/trait_flavor"
        path = "main_menu/common/trait_flavor"
        path = "loading_screen/common/trait_flavor"
        path_extension = .txt
    }
}

trait_flavor = {
    alias_name[color] = alias_match_left[color]
}
