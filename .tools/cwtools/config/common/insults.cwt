types = {
    type[insult] = {
        path = "common/insults"
        path = "in_game/common/insults"
        path = "main_menu/common/insults"
        path = "loading_screen/common/insults"
        path_extension = .txt
        localisation = {
            name = "$"
        }
    }
}

insult = {
    trigger = single_alias_right[trigger_clause]
}
