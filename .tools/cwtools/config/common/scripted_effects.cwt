types = {
    type[scripted_effect] = {
        path = "common/scripted_effects"
        path = "in_game/common/scripted_effects"
        path = "main_menu/common/scripted_effects"
        path = "loading_screen/common/scripted_effects"
        path_extension = .txt
    }
    type[inline_scripted_effect] = {
        path = "events"
        path = "in_game/events"
        path = "main_menu/events"
        path = "loading_screen/events"
        path_extension = .txt
        type_key_prefix = "scripted_effect"
    }
}

scripted_effect = {
    ## cardinality = 0..inf
    alias_name[effect] = alias_match_left[effect]
}

alias[effect:<scripted_effect>] = bool

### The scripted trigger will draw the value of the right clause via $left_clause$.
alias[effect:<scripted_effect>] = {
    ## cardinality = 0..inf
    $parameter = $parameter_value
}

inline_scripted_effect = {
    ## cardinality = 0..inf
    alias_name[effect] = alias_match_left[effect]
}

alias[effect:<inline_scripted_effect>] = bool

### The scripted trigger will draw the value of the right clause via $left_clause$.
alias[effect:<inline_scripted_effect>] = {
    ## cardinality = 0..inf
    $parameter = $parameter_value
}
