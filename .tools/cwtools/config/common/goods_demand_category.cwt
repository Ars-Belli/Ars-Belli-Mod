types = {
    type[goods_demand_category] = {
        path = "common/goods_demand_category"
        path = "in_game/common/goods_demand_category"
        path = "main_menu/common/goods_demand_category"
        path = "loading_screen/common/goods_demand_category"
        path_extension = .txt
        localisation = {
            name = "$"
        }
    }
}

goods_demand_category = {
    ## cardinality = 0..1
    display = enum[goods_demand_category_display_type]
}
